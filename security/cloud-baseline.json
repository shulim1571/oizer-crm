{
  "_about": "Expected cloud security settings, checked daily by scripts/security/cloud-check.mjs. No secrets here. Each change needs a reason in the commit message. Recorded 2026-11-12.",
  "supabase": {
    "advisor_fail_levels": ["ERROR"],
    "advisor_max_counts": {
      "authenticated_security_definer_function_executable": 251,
      "rls_enabled_no_policy": 37,
      "function_search_path_mutable": 29,
      "anon_security_definer_function_executable": 10,
      "extension_in_public": 1
    },
    "_anon_executable_functions": "Signed-out callers reach these by design (payment page, receipts, unsubscribe, shared documents, organization lookup); rls_auto_enable is Supabase's event-trigger function and cannot be called through the API.",
    "anon_executable_functions": ["donary_track", "org_footer", "public_cover_fee", "public_give_page", "recurring_card", "request_receipt", "resolve_org", "rls_auto_enable", "shared_document", "unsubscribe_email"],
    "_functions_without_jwt_verification": "Each authenticates itself: signed-in user token, API key, cron token, provider signature, per-organization secret, or is the public payment page.",
    "functions_without_jwt_verification": ["sign-in", "send-messages", "message-events", "payments", "sola-webhook", "give", "recurring-charges", "api", "domains", "voice", "donary-sync", "donary-webhook", "plaid", "assistant", "phone-code", "make-ingest", "usps-address"],
    "auth_equals": {
      "mfa_totp_enroll_enabled": true,
      "mfa_totp_verify_enabled": true,
      "password_hibp_enabled": true,
      "mailer_autoconfirm": false,
      "external_anonymous_users_enabled": false,
      "refresh_token_rotation_enabled": true
    },
    "auth_at_least": { "password_min_length": 12 },
    "auth_at_most": { "sessions_timebox": 12, "sessions_inactivity_timeout": 0.5, "jwt_exp": 3600 },
    "backup_max_age_hours": 36,
    "pitr_enabled": false,
    "db_ssl_enforced": false,
    "db_open_to_all_ips": true,
    "anon_readable": []
  },
  "site": {
    "site_headers": {
      "strict-transport-security": "max-age=\\d+",
      "x-content-type-options": "^nosniff$",
      "x-frame-options": "^(DENY|SAMEORIGIN)$",
      "referrer-policy": "strict-origin|no-referrer|same-origin"
    },
    "hsts_min_seconds": 15552000,
    "cert_min_days": 14
  },
  "cloudflare": {
    "pages": { "production_branch": "main", "domains": ["oizer.trubase.org"] },
    "workers": {
      "oizer-give-gate": { "workers_dev": true },
      "oizer-status": { "workers_dev": true }
    }
  }
}
